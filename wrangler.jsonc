{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skup-zlota-gorzow",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "PRICE_STORE",
      "id": "f68ca9ff795d42968f384ef81c624618"
    }
  ],
  "vars": {
    "CACHE_SECONDS": "300",
    "PROVIDER_URL": "https://investgold.pl/sezamcalc2.json"
  },
  "triggers": { "crons": ["*/5 * * * *"] }
}
